# ─────────────────────────────────────────────────────────────
#  Shots Chupitería — variabili d'ambiente
#  Copia questo file in `.env` e compila i valori.
# ─────────────────────────────────────────────────────────────

# Database. SQLite va benissimo per un singolo locale.
# Postgres: "postgresql://utente:password@host:5432/shots" (vedi README).
DATABASE_URL="file:./data/shots.db"

# Segreto per firmare il cookie di sessione dello staff.
# Genera con: openssl rand -base64 32
APP_SECRET=""

# PIN che i barman digitano su /bar per aprire la coda.
STAFF_PIN="1234"

# Identità del locale.
VENUE_NAME="Shots Chupitería"
NEXT_PUBLIC_VENUE_TZ="Europe/Rome"
# Ora in cui riparte il progressivo giornaliero (le 04:00 sono ancora "ieri sera").
SERVICE_DAY_START_HOUR="6"

# URL pubblico dell'app: finisce dentro il QR dello scontrino.
# Obbligatorio in produzione dietro proxy/CDN.
NEXT_PUBLIC_APP_URL="https://ordina.iltuolocale.it"

# ── Stripe ───────────────────────────────────────────────────
# Senza queste chiavi l'app parte in MODALITÀ DEMO: il flusso è
# completo ma nessun importo viene addebitato.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Ottenuto con `stripe listen` o dalla dashboard (endpoint webhook).
STRIPE_WEBHOOK_SECRET=""

# Durata della sessione staff in secondi (default 12 ore).
STAFF_SESSION_TTL_SECONDS="43200"
